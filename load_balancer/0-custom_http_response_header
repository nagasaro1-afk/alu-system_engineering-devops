#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx and a custom X-Served-By header
# whose value is the hostname of the server
# shellcheck disable=SC2154

sudo apt-get update -y
sudo apt-get install -y nginx

# $hostname is a built-in Nginx variable holding the server's hostname
echo 'add_header X-Served-By $hostname;' | sudo tee /etc/nginx/conf.d/custom_header.conf > /dev/null

sudo nginx -t
sudo service nginx restart
