#!/usr/bin/env bash
# Installs nginx with a 301 redirect and a custom 404 page
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School" | sudo tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html > /dev/null
sudo sed -i '/server_name _;/a location /redirect_me {\n return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n }\n error_page 404 /404.html;\n location = /404.html {\n internal;\n }' /etc/nginx/sites-available/default
sudo service nginx restart
